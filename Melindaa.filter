ItemDisplay[UNI]: %GOLD%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[SET]: %GREEN%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[RARE]: %YELLOW%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[CRAFT]: %ORANGE%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[MAG]: %BLUE%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[RW]: %GOLD%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[RUNE>0]: %ORANGE%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[GOLD>0]: %GOLD%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[NMAG !RW !(RUNE>0) !(GOLD>0) (ETH OR SOCK>0)]: %GRAY%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[NMAG !RW !(RUNE>0) !(GOLD>0) !ETH SOCK=0]: %WHITE%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[GROUND ID MAPTIER>0]: %MAP-84%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[GROUND ID UNI !MAPTIER>0]: %MAP-68%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[GROUND ID SET !MAPTIER>0]: %MAP-7D%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[GROUND (RUNE>29 RUNE<34)]: %SOUNDID-4719%%MAP-20%%NAME%{%NAME%}%CONTINUE%
ItemDisplay[GROUND (RUNE>25 RUNE<30)]: %SOUNDID-4714%%MAP-20%%NAME%{%NAME%}%CONTINUE%
